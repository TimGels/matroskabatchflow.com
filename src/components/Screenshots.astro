---
import { getImage } from "astro:assets";
import Carousel from "./Carousel.svelte";
import inputPageLight from "../assets/screenshots/Input-Page-Light.png";
import inputPageDark from "../assets/screenshots/Input-Page-Dark.png";
import validationPageLight from "../assets/screenshots/Validation-Page-Light.png";
import validationPageDark from "../assets/screenshots/Validation-Page-Dark.png";
import audioConfigPageLight from "../assets/screenshots/Audio-Config-Page-Light.png";
import audioConfigPageDark from "../assets/screenshots/Audio-Config-Page-Dark.png";
import resultsPageLight from "../assets/screenshots/Results-Page-Light.png";
import resultsPageDark from "../assets/screenshots/Results-Page-Dark.png";
import settingsPageLight from "../assets/screenshots/Settings-Page-Light.png";
import settingsPageDark from "../assets/screenshots/Settings-Page-Dark.png";

const screenshots = [
  {
    imageLight: inputPageLight,
    imageDark: inputPageDark,
    alt: "Input Page: Add files for batch processing",
    caption: "Input Page",
    description: "Add files for batch processing",
  },
  {
    imageLight: validationPageLight,
    imageDark: validationPageDark,
    alt: "Validation Page: Compare files track by track",
    caption: "Validation Page",
    description: "Compare files track by track",
  },
  {
    imageLight: audioConfigPageLight,
    imageDark: audioConfigPageDark,
    alt: "Track Configuration: Edit track properties",
    caption: "Track Configuration",
    description: "Edit track properties",
  },
  {
    imageLight: resultsPageLight,
    imageDark: resultsPageDark,
    alt: "Results Page: Review processing results",
    caption: "Results Page",
    description: "Review processing results",
  },
  {
    imageLight: settingsPageLight,
    imageDark: settingsPageDark,
    alt: "Settings Page: Customize application preferences",
    caption: "Settings Page",
    description: "Customize application preferences",
  },
];

const slides = await Promise.all(
  screenshots.map(async ({ imageLight, imageDark, alt, caption, description }) => {
    const light = await getImage({ src: imageLight });
    const dark = await getImage({ src: imageDark });
    return {
      src: light.src,
      darkSrc: dark.src,
      alt,
      caption,
      description,
      width: light.attributes.width,
      height: light.attributes.height,
    };
  }),
);
---

<section
  id="screenshots"
  class="py-20 sm:py-28 bg-surface-50 dark:bg-surface-900/50 transition-colors">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2
        class="text-3xl sm:text-4xl font-bold text-surface-900 dark:text-white mb-4">
        See It in Action
      </h2>
      <p
        class="text-lg text-surface-600 dark:text-surface-400 max-w-2xl mx-auto">
        A modern interface built for clarity and efficiency.
      </p>
    </div>
    <Carousel slides={slides} client:load />
  </div>
</section>
