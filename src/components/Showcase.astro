---
import { Image } from "astro:assets";
import inputPageLight from "../assets/screenshots/Input-Page-Light.png";
import inputPageDark from "../assets/screenshots/Input-Page-Dark.png";
import validationPageLight from "../assets/screenshots/Validation-Page-Light.png";
import validationPageDark from "../assets/screenshots/Validation-Page-Dark.png";
import audioConfigPageLight from "../assets/screenshots/Audio-Config-Page-Light.png";
import audioConfigPageDark from "../assets/screenshots/Audio-Config-Page-Dark.png";
import resultsPageLight from "../assets/screenshots/Results-Page-Light.png";
import resultsPageDark from "../assets/screenshots/Results-Page-Dark.png";
import settingsPageLight from "../assets/screenshots/Settings-Page-Light.png";
import settingsPageDark from "../assets/screenshots/Settings-Page-Dark.png";

// Each screenshot has a light and a dark version that follows the site theme.
const sections = [
  {
    heading: "Add your files",
    body: "Drop in your files and get ready to start configuring properties the way you like. Matroska Batch Flow automatically analyzes each file and sets everything up for batch editing.",
    imageLight: inputPageLight,
    imageDark: inputPageDark,
    alt: "Input page listing six MKV files, a summary of two advisory checks, and a Batch checks column",
    imageRight: true,
  },
  {
    heading: "Review the batch",
    body: "The Validation page compares your files track by track. See which files have a different language tag or are missing a track, and open the settings for that track straight from the check.",
    imageLight: validationPageLight,
    imageDark: validationPageDark,
    alt: "Validation page comparing subtitle track 2 language tags: Portuguese in six files, English in one, and no track in three",
    imageRight: false,
  },
  {
    heading: "Configure properties",
    body: "Set track names, languages, flags, and other properties across all files from one place. Visual indicators show which tracks are shared across files, giving you a clear picture before you make any changes.",
    imageLight: audioConfigPageLight,
    imageDark: audioConfigPageDark,
    alt: "Audio options for track 2, with its name, language, and default flag set for every file in the batch",
    imageRight: true,
  },
  {
    heading: "Apply changes and review results",
    body: "After applying changes, open Results to see which files were updated and expand a file to read its warnings or errors. Use the saved result picker to revisit or remove earlier runs.",
    imageLight: resultsPageLight,
    imageDark: resultsPageDark,
    alt: "Results page with a saved batch selected and file rows showing a failure and a warning",
    imageRight: false,
  },
  {
    heading: "Make it yours",
    body: "Tune validation, choose a theme, and decide how many batch results to keep. Your preferences are saved for the next time you open the app.",
    imageLight: settingsPageLight,
    imageDark: settingsPageDark,
    alt: "Settings showing Strict validation, the app theme, and a saved-results limit of 20",
    imageRight: true,
  },
];
---

<section id="showcase" class="py-20 sm:py-28 transition-colors">
  <div class="container mx-auto px-4 space-y-28 sm:space-y-36">
    {
      sections.map(({ heading, body, imageLight, imageDark, alt, imageRight }) => (
        <div
          class:list={[
            "flex flex-col gap-10 lg:gap-16 items-center",
            imageRight ? "lg:flex-row" : "lg:flex-row-reverse",
          ]}>
          {/* Text */}
          <div class="flex-1 max-w-xl">
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-surface-900 dark:text-white mb-5 leading-snug">
              {heading}
            </h2>
            <p class="text-lg text-surface-600 dark:text-surface-400 leading-relaxed">
              {body}
            </p>
          </div>

          {/* Screenshot */}
          <div class="flex-1 w-full max-w-2xl">
            <div class="rounded-2xl overflow-hidden shadow-2xl shadow-surface-900/20 dark:shadow-surface-950/50 border border-surface-200 dark:border-surface-700/50 ring-1 ring-surface-900/5 dark:ring-white/5">
              <Image
                src={imageLight}
                alt={alt}
                class="w-full h-auto dark:hidden"
                loading="lazy"
              />
              <Image
                src={imageDark}
                alt={alt}
                class="w-full h-auto hidden dark:block"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
